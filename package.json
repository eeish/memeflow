{
  "name": "cord",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "service:start": "cd service && RUST_LOG=info cargo run --bin cord-service",
    "service:test": "cd service && cargo test",
    "db:reset": "python3 scripts/reset_database.py",
    "dev:start": "./dev.sh start",
    "dev:stop": "./dev.sh stop",
    "dev:status": "./dev.sh status",
    "dev:reset": "./dev.sh reset",
    "contract:build": "cd contracts/cord && sui move build",
    "contract:test": "cd contracts/cord && sui move test",
    "contract:fmt": "cd contracts/cord && sui move fmt",
    "contract:deploy": "python3 scripts/deploy.py",
    "contract:deploy:devnet": "python3 scripts/deploy.py devnet",
    "contract:deploy:testnet": "python3 scripts/deploy.py testnet",
    "contract:clean": "rm -rf contracts/*/build",
    "clean": "rm -rf dist node_modules/.vite contracts/*/build",
    "test": "npm run typecheck && npm run lint",
    "ci": "npm run test && npm run build"
  },
  "dependencies": {
    "@mysten/dapp-kit": "^1.0.1",
    "@mysten/sui": "^2.1.0",
    "@mysten/sui.js": "^0.54.1",
    "@mysten/zklogin": "^0.7.0",
    "@tanstack/react-query": "^5.84.1",
    "jose": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^20.11.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
}
