# Cord Environment Configuration
# Copy this file to .env.local and fill in your values.
#
# Design principle:
#   - public/deployment-<network>.json  →  source of truth for all contract addresses
#   - .env.local                        →  only what must be known at build/boot time
#
# After deploying contracts, run:
#   python scripts/deploy.py testnet
# This updates deployment-testnet.json AND the two required vars below.

# =============================================================================
# Required: Network selector
# Determines which deployment-<network>.json is loaded and which RPC is used.
# =============================================================================
VITE_SUI_NETWORK=testnet

# =============================================================================
# Required: Bonding curve constant
# Must match maxSupply in the active deployment JSON.
# Kept in sync automatically by the deploy script.
# =============================================================================
VITE_MAX_SUPPLY=30

# =============================================================================
# Optional: Per-network RPC overrides
# Default endpoints come from @mysten/dapp-kit's getFullnodeUrl().
# Uncomment only if you need to point at a custom node.
# =============================================================================
# VITE_TESTNET_RPC=https://fullnode.testnet.sui.io:443
# VITE_MAINNET_RPC=https://fullnode.mainnet.sui.io:443
# VITE_DEVNET_RPC=https://fullnode.devnet.sui.io:443
# VITE_LOCALNET_RPC=http://127.0.0.1:9000

# =============================================================================
# zkLogin
# =============================================================================
VITE_GOOGLE_CLIENT_ID=
