# MemeFlow Environment Configuration

# Application Settings
VITE_APP_NAME=MemeFlow
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION="Social Token Trading Platform"

# Network Configuration
VITE_NETWORK=testnet
VITE_PACKAGE_ID=YOUR_PACKAGE_ID_HERE

# Sui Network RPC Endpoints
VITE_TESTNET_RPC=https://fullnode.testnet.sui.io:443
VITE_MAINNET_RPC=https://fullnode.mainnet.sui.io:443
VITE_DEVNET_RPC=https://fullnode.devnet.sui.io:443
VITE_LOCAL_RPC=http://127.0.0.1:9000

# API Configuration (Future Implementation)
VITE_API_BASE_URL=https://api.memeflow.io
VITE_WEBSOCKET_URL=wss://ws.memeflow.io

# Feature Flags
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_SEARCH=true
VITE_ENABLE_REAL_TIME_UPDATES=true

# Development Settings
VITE_DEBUG_MODE=false
VITE_MOCK_DATA=true