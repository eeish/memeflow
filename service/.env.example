# ============================================================================
# Cord Service Configuration
# ============================================================================
# Copy this file to .env and fill in your actual credentials
# cp .env.example .env

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
# Local development (start Postgres via: docker compose -f docker-compose.dev.yml up -d postgres)
DATABASE_URL=postgres://cord:cord@localhost:5432/cord
# Railway injects DATABASE_URL automatically — no need to set it in the Railway dashboard.

# ----------------------------------------------------------------------------
# Cloudflare R2 Storage Configuration (REQUIRED for media uploads)
# ----------------------------------------------------------------------------
# Get these credentials from: https://dash.cloudflare.com/ → R2 → Manage R2 API Tokens

# Your Cloudflare Account ID (found in R2 dashboard URL)
R2_ACCOUNT_ID=d30f1b70fb8da7e274e29db42d826749

# R2 API Token Credentials (Create API token with "Object Read & Write" permissions)
# R2 API Token Credentials (Create API token with "Object Read & Write" permissions)
R2_ACCESS_KEY_ID=d4593180ca0869dcdf1ba37bde4a093b
R2_SECRET_ACCESS_KEY=1ddd5ef29ef34726da6ba36e3c3f021d7b37ac641837b89a9f09afdcee8325be

# R2 Bucket Name (the bucket must exist in your R2 account)
R2_BUCKET_NAME=cord

# R2 Public Domain (your R2 bucket's public URL - enable "Public Access" in R2 settings)
# Format: pub-xxxxxxxxxxxxx.r2.dev or your custom domain
R2_PUBLIC_DOMAIN=img.c0rd.xyz

# ----------------------------------------------------------------------------
# Optional: Sui Network Configuration
# ----------------------------------------------------------------------------
# SUI_NETWORK_URL=https://fullnode.devnet.sui.io:443

# ----------------------------------------------------------------------------
# Optional: Logging Level
# ----------------------------------------------------------------------------
# RUST_LOG=info
