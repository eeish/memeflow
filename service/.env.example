# MemeFlow Service Configuration

# Server Configuration
HOST=0.0.0.0
PORT=3001

# Database Configuration
# For SQLite (development)
DATABASE_URL=sqlite:./memeflow.db

# For PostgreSQL (production)
# DATABASE_URL=postgresql://username:password@localhost:5432/memeflow

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION_HOURS=24

# Logging
RUST_LOG=info

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Sui Network Configuration
SUI_NETWORK_URL=https://fullnode.testnet.sui.io:443
# SUI_NETWORK_URL=https://fullnode.mainnet.sui.io:443  # For mainnet
# SUI_NETWORK_URL=http://localhost:9000                # For local network

# External Services (optional)
# TWITTER_API_KEY=your-twitter-api-key
# DISCORD_WEBHOOK_URL=your-discord-webhook

# File Upload (future feature)
# MAX_FILE_SIZE=10485760  # 10MB in bytes
# UPLOAD_DIR=./uploads

# Rate Limiting (future feature)  
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_BURST=10